<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only needed for the optional App Usage Timer. Nothing is monitored until the user turns the timer on
         and grants "Usage access" in Android settings (a special access, not a normal permission).
         It lets the launcher read how long the apps the user chose were on screen. The data never leaves the phone. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Android 13+: lets the "time is up" reminder show. Asked for only when the timer is turned on, and optional. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Required since Android 9 (API 28) for any app that asks Android to uninstall another app
         (Intent.ACTION_DELETE). Without it the system refuses the request and shows an error.
         It is a normal install-time permission: no prompt, and it does NOT allow silent uninstalling.
         Android still shows its own confirmation screen every time. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- QUERY_ALL_PACKAGES is deliberately not used:
         the <queries> block below is enough to list launchable apps and home apps. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Icon packs: lets the launcher see installed apps that offer icons through the common theme actions
             (and nothing else). Without these entries Android hides icon pack apps from this launcher. -->
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
        <intent>
            <action android:name="com.anddoes.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="org.adw.ActivityStarter.THEMES" />
        </intent>
    </queries>

    <application
        android:name=".MyLauncherApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyLauncher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize">

            <!-- Makes the app selectable as the Android HOME app -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Lets the app also be opened like a normal app -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Wakes briefly to re-check an app timer and show the "time is up" reminder. Not exported. -->
        <receiver
            android:name=".timer.TimerAlarmReceiver"
            android:exported="false" />
    </application>
</manifest>
